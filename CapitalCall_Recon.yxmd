            <FormulaField expression="[Received_Clean] - [Called_Clean]" field="Difference" size="8" type="Double" enabled="true" />
            <FormulaField expression="IF IsNull([Amount_Called_EUR]) THEN &quot;Unidentified receipt - investigate before booking&quot;&#xA;ELSEIF IsNull([Received_EUR]) THEN &quot;Outstanding - no cash received&quot;&#xA;ELSEIF [Difference] = 0 THEN &quot;Matched&quot;&#xA;ELSEIF Abs([Difference]) &lt;= 25 THEN &quot;Matched within tolerance - bank charges&quot;&#xA;ELSE &quot;Break - amount differs&quot;&#xA;ENDIF" field="Status" size="2147483647" type="V_String" enabled="true" />
            <FormulaField expression="IIF(IsNull([Received_EUR]) AND !IsNull([Due_Date]), DateTimeDiff(DateTimeToday(), [Due_Date], &quot;days&quot;), 0)" field="Days_Overdue" size="4" type="Int32" enabled="true" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Received_Clean = IIF(IsNull([Received_EUR]), 0, [Received_EUR])
Called_Clean = I...</DefaultAnnotationText>
